<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/aodRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Always-on heart rate display. Tap to exit.">

        <!-- Clock -->
        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="76sp"
            android:textColor="#F0F0F0"
            android:letterSpacing="0.02"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#9A9A9A"
            android:layout_marginTop="6dp" />

        <!-- Battery: level, charge status, watts, time remaining -->
        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 --%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#B8B8B8"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="36dp" />

        <!-- Heart rate -->
        <TextView
            android:id="@+id/aodBpmText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="112sp"
            android:textStyle="bold"
            android:textColor="#FF4D4D"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/aodBpmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BPM"
            android:textSize="13sp"
            android:letterSpacing="0.3"
            android:textColor="#9A9A9A"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/aodHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tap to exit  ·  hold to dim"
            android:textSize="11sp"
            android:textColor="#707070"
            android:layout_marginTop="56dp" />

    </LinearLayout>

</FrameLayout>
